{
  "name": "mips-pipeline-workbench-visualizer",
  "version": "1.0.0",
  "private": true,
  "description": "Accessible dependency-light pipeline trace visualizer",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "npm run build && node --test build/tests/*.test.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
